// Purpose: Find accounts targeted by attacker infrastructure that recorded failures but no successful attacker sign-in.
// The executable query below is identical to the query used for the submitted screenshot.
CloudoraSignIn_CL
| where IPAddress startswith "102.89."
| summarize
    SuccessCount = countif(ResultType == "0"),
    FailCount = countif(ResultType == "50126")
    by UserPrincipalName
| where SuccessCount == 0 and FailCount > 0
| project UserPrincipalName, FailCount
| order by FailCount desc
