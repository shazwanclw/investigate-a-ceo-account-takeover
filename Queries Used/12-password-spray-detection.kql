// Purpose: Hunt historical data for a six-hour password-spray signature.
// For a scheduled rule, replace the bin() range with TimeGenerated > ago(6h).
CloudoraSignIn_CL
| where ResultType == "50126"
| summarize Failures=count(), TargetedAccounts=dcount(UserPrincipalName), SampleAccounts=make_set(UserPrincipalName, 5)
    by IPAddress, Country, bin(TimeGenerated, 6h)
| where TargetedAccounts >= 5
| order by TimeGenerated asc, TargetedAccounts desc
