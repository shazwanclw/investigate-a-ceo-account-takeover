// Purpose: Detect one source IP attempting invalid passwords against many accounts in a six-hour window.
// The executable query below is identical to the query used for the submitted screenshot.
CloudoraSignIn_CL
| where ResultType == "50126"
| summarize TargetCount = dcount(UserPrincipalName) by IPAddress, bin(TimeGenerated, 6h)
| where TargetCount >= 5
